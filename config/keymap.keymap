#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    combos {
        compatible = "zmk,combos";

        ei {
            bindings = <&kp LANG2>;
            key-positions = <21 22>;
        };

        kana {
            bindings = <&kp LANG1>;
            key-positions = <29 30>;
        };

        esc {
            bindings = <&kp ESC>;
            key-positions = <0 1>;
        };

        tab {
            bindings = <&kp TAB>;
            key-positions = <1 2>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        main_layer {
            bindings = <
&kp Q      &kp W     &kp E     &kp R         &kp T                 &kp Y             &kp U        &kp I       &kp O   &kp P
&kp A      &kp S     &lt 3 D   &lt 2 F       &kp G                 &kp H             &kp J        &kp K       &kp L   &kp MINUS
&kp Z      &kp X     &kp C     &kp V         &kp B                 &trans            &trans       &kp N       &kp M   &kp COMMA         &kp DOT  &kp SLASH
&kp LCTRL  &kp LGUI  &kp LALT  &kp LEFT_GUI  &mt LEFT_SHIFT SPACE  &kp LS(LEFT_GUI)  &lt 4 ENTER  &lt 1 BSPC  &trans  &kp LC(UP_ARROW)
            >;
        };

        top_symbol_layer {
            bindings = <
&kp LS(N1)  &kp LS(N2)  &kp LS(N3)  &kp LS(N4)  &kp LS(N5)  &kp LS(N6)  &kp LS(N7)      &kp LS(N8)    &kp LS(N9)       &kp LS(N0)
&trans      &trans      &trans      &trans      &trans      &trans      &kp LEFT_ARROW  &kp UP_ARROW  &kp RIGHT_ARROW  &trans
&trans      &trans      &trans      &trans      &trans      &trans      &trans          &trans        &trans           &kp DOWN_ARROW  &trans  &trans
&trans      &trans      &trans      &trans      &trans      &trans      &trans          &trans        &trans           &trans
            >;
        };

        symbol_layer {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &kp GRAVE  &kp LBKT    &kp RBKT    &kp EQUAL  &kp BACKSLASH
&trans  &trans  &trans  &trans  &trans  &trans     &kp LS(N9)  &kp LS(N0)  &kp SEMI   &kp SINGLE_QUOTE
&trans  &trans  &trans  &trans  &trans  &trans     &trans      &trans      &trans     &trans            &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans     &trans      &trans      &trans     &trans
            >;
        };

        symbol_shift_layer {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &kp LS(GRAVE)  &kp LS(LBKT)  &kp LS(RBKT)  &kp LS(EQUAL)  &kp LS(BACKSLASH)
&trans  &trans  &trans  &trans  &trans  &trans         &trans        &trans        &kp LS(SEMI)   &kp LS(SINGLE_QUOTE)
&trans  &trans  &trans  &trans  &trans  &trans         &trans        &trans        &trans         &trans                &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans         &trans        &trans        &trans         &trans
            >;
        };

        function_number_layer {
            bindings = <
&kp F9  &kp F10  &kp F11  &kp F12  &trans  &kp N7        &kp N8        &kp N9        &trans        &trans
&kp F5  &kp F6   &kp F7   &kp F8   &trans  &kp NUMBER_4  &kp N5        &kp NUMBER_6  &trans        &trans
&kp F1  &kp F2   &kp F3   &kp F4   &trans  &trans        &kp NUMBER_0  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &trans  &trans
&trans  &trans   &trans   &trans   &trans  &trans        &trans        &trans        &trans        &trans
            >;
        };

        mouse_layer {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &mkp MB4   &mkp MCLK  &mkp MB5   &trans
&trans  &trans  &trans  &trans  &trans  &trans  &mkp LCLK  &mo 6      &mkp RCLK  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans     &trans     &trans     &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans     &trans     &trans     &trans
            >;
        };

        scroll_layer {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
